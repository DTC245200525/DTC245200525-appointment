# ==========================================
# APPOINTMENT SYSTEM - ENVIRONMENT VARIABLES
# ==========================================
# Hướng dẫn: Tạo bản sao file này thành .env và chỉnh sửa các giá trị phù hợp:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env

# ------------------------------------------
# 1. CẤU HÌNH ỨNG DỤNG (APP CONFIG)
# ------------------------------------------
# Cổng ứng dụng Node.js (mặc định 3000)
PORT=3000

# ------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (DATABASE)
# ------------------------------------------
# Tên database
POSTGRES_DB=appointment_db

# Tên người dùng database
POSTGRES_USER=appointment_user

# Mật khẩu database (Thay đổi bằng mật khẩu an toàn)
POSTGRES_PASSWORD=your_postgres_password_here

# Host kết nối cơ sở dữ liệu:
# - Chạy với Docker Compose: dùng "postgres" (tên container)
# - Chạy Node.js trực tiếp trên máy (local dev): dùng "localhost"
DB_HOST=postgres

# Cổng kết nối PostgreSQL
DB_PORT=5432

# ------------------------------------------
# 3. QUẢN TRỊ PGADMIN (PGADMIN 4)
# ------------------------------------------
# Email đăng nhập pgAdmin (truy cập tại http://127.0.0.1:5050)
PGADMIN_EMAIL=admin@example.com

# Mật khẩu đăng nhập pgAdmin (Thay đổi bằng mật khẩu an toàn)
PGADMIN_PASSWORD=your_pgadmin_password_here
